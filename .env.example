# Mapbox API Key
NEXT_PUBLIC_MAPBOX_API_KEY=your_mapbox_api_key_here

# Google Maps API Key (for Places Autocomplete)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Repliers API Key (get from repliers.io dashboard)
REPLIERS_API_KEY=your_repliers_api_key_here

# Base URL for server-side fetches (set to your production domain in deployment)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
